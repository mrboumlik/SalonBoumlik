rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Global safety net: deny all unspecified paths by default
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper primitives
    function isValidId(id) {
      return id is string && id.size() >= 3 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidBarberSlug(id) {
      return id is string && id.size() >= 2 && id.size() <= 64 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Strict schema & size validation blueprint for Booking documents
    function isValidBooking(data) {
      return data.keys().hasAll([
        'id', 'ticketNumber', 'barberId', 'barberName',
        'date', 'timeSlot', 'clientName', 'clientPhone',
        'status', 'createdAt'
      ])
      && data.keys().hasOnly([
        'id', 'ticketNumber', 'barberId', 'barberName', 'barberColor',
        'date', 'timeSlot', 'clientName', 'clientPhone', 'clientEmail',
        'clientNotes', 'notes', 'services', 'cartItemsSummary', 'originalTotalMAD',
        'finalTotalMAD', 'totalSavingsMAD', 'bookingMethod',
        'drinkPreference', 'totalDurationMinutes', 'status',
        'isFlexibleTime', 'preferredTimeHint',
        'rescheduledTo', 'clientLanguage', 'adminNotes',
        'cihReceiptName', 'cihReceiptPreview', 'cihReceiptUploadedAt',
        'loyaltyRewardApplied', 'attendanceConfirmedAt',
        'checkInToken', 'checkedInAt', 'caisseLoggedAt', 'caisseEntryId',
        'deviceFingerprint', 'clientIpHash', 'isAdminWalkIn',
        'createdAt'
      ])
      && isValidId(data.id)
      && data.ticketNumber is string && data.ticketNumber.size() >= 3 && data.ticketNumber.size() <= 32
      && data.barberId is string && data.barberId.size() >= 1 && data.barberId.size() <= 64
      && data.barberName is string && data.barberName.size() >= 1 && data.barberName.size() <= 100
      && (!('barberColor' in data) || (data.barberColor is string && data.barberColor.size() <= 20))
      && data.date is string && data.date.size() >= 8 && data.date.size() <= 20
      && data.timeSlot is string && data.timeSlot.size() >= 3 && data.timeSlot.size() <= 16
      && data.clientName is string && data.clientName.size() >= 1 && data.clientName.size() <= 120
      && data.clientPhone is string && data.clientPhone.size() >= 6 && data.clientPhone.size() <= 40
      && (!('clientEmail' in data) || (data.clientEmail is string && data.clientEmail.size() <= 120))
      && (!('clientNotes' in data) || (data.clientNotes is string && data.clientNotes.size() <= 400))
      && (!('notes' in data) || (data.notes is string && data.notes.size() <= 500))
      && (!('services' in data) || (data.services is list && data.services.size() <= 20))
      && (!('cartItemsSummary' in data) || (data.cartItemsSummary is list && data.cartItemsSummary.size() <= 20))
      && (!('originalTotalMAD' in data) || (data.originalTotalMAD is number && data.originalTotalMAD >= 0 && data.originalTotalMAD <= 50000))
      && (!('finalTotalMAD' in data) || (data.finalTotalMAD is number && data.finalTotalMAD >= 0 && data.finalTotalMAD <= 50000))
      && (!('totalSavingsMAD' in data) || (data.totalSavingsMAD is number && data.totalSavingsMAD >= 0 && data.totalSavingsMAD <= 50000))
      && (!('bookingMethod' in data) || data.bookingMethod in ['site', 'whatsapp'])
      && (!('drinkPreference' in data) || data.drinkPreference in ['coffee', 'tea', 'none'])
      && (!('totalDurationMinutes' in data) || (data.totalDurationMinutes is number && data.totalDurationMinutes >= 0 && data.totalDurationMinutes <= 1000))
      && data.status in ['pending', 'pending_quote', 'flexible_pending', 'confirmed', 'rescheduled', 'completed', 'no_show', 'rejected', 'cancelled']
      && (!('isFlexibleTime' in data) || data.isFlexibleTime is bool)
      && (!('preferredTimeHint' in data) || (data.preferredTimeHint is string && data.preferredTimeHint.size() <= 32))
      && (!('rescheduledTo' in data) || (
        data.rescheduledTo is map
        && data.rescheduledTo.keys().hasAll(['date', 'time'])
        && data.rescheduledTo.keys().hasOnly(['date', 'time'])
        && data.rescheduledTo.date is string && data.rescheduledTo.date.size() <= 20
        && data.rescheduledTo.time is string && data.rescheduledTo.time.size() <= 16
      ))
      && (!('clientLanguage' in data) || data.clientLanguage in ['fr', 'ar', 'en', 'amz', 'es'])
      && (!('adminNotes' in data) || (data.adminNotes is string && data.adminNotes.size() <= 500))
      && (!('cihReceiptName' in data) || (data.cihReceiptName is string && data.cihReceiptName.size() <= 160))
      && (!('cihReceiptPreview' in data) || (data.cihReceiptPreview is string && data.cihReceiptPreview.size() <= 200000))
      && (!('cihReceiptUploadedAt' in data) || (data.cihReceiptUploadedAt is string && data.cihReceiptUploadedAt.size() <= 64))
      && (!('loyaltyRewardApplied' in data) || (data.loyaltyRewardApplied is string && data.loyaltyRewardApplied.size() <= 200))
      && (!('attendanceConfirmedAt' in data) || (data.attendanceConfirmedAt is string && data.attendanceConfirmedAt.size() <= 64))
      && (!('checkInToken' in data) || (data.checkInToken is string && data.checkInToken.size() <= 32))
      && (!('checkedInAt' in data) || (data.checkedInAt is string && data.checkedInAt.size() <= 64))
      && (!('caisseLoggedAt' in data) || (data.caisseLoggedAt is string && data.caisseLoggedAt.size() <= 64))
      && (!('caisseEntryId' in data) || (data.caisseEntryId is string && data.caisseEntryId.size() <= 128))
      && (!('deviceFingerprint' in data) || (data.deviceFingerprint is string && data.deviceFingerprint.size() <= 128))
      && (!('clientIpHash' in data) || (data.clientIpHash is string && data.clientIpHash.size() <= 128))
      && (!('isAdminWalkIn' in data) || data.isAdminWalkIn is bool)
      && data.createdAt is string && data.createdAt.size() >= 10 && data.createdAt.size() <= 64;
    }

    function isValidSalonSettings(data) {
      return data.keys().hasAll(['googleMapsUrl', 'googleReviewUrl', 'updatedAt'])
      && data.keys().hasOnly(['googleMapsUrl', 'googleReviewUrl', 'salonPhone', 'salonWhatsapp', 'additionalPhones', 'updatedAt'])
      && data.googleMapsUrl is string && data.googleMapsUrl.size() >= 10 && data.googleMapsUrl.size() <= 500
      && data.googleMapsUrl.matches('^https://.*$')
      && data.googleReviewUrl is string && data.googleReviewUrl.size() >= 10 && data.googleReviewUrl.size() <= 500
      && data.googleReviewUrl.matches('^https://.*$')
      && (!('salonPhone' in data) || (data.salonPhone is string && data.salonPhone.size() <= 40))
      && (!('salonWhatsapp' in data) || (data.salonWhatsapp is string && data.salonWhatsapp.size() <= 40))
      && (!('additionalPhones' in data) || (data.additionalPhones is list && data.additionalPhones.size() <= 10))
      && data.updatedAt is string && data.updatedAt.size() >= 10 && data.updatedAt.size() <= 64;
    }

    function isValidBarberSchedule(data) {
      return data.keys().hasAll([
        'id', 'barberId', 'offWeekdays', 'offDates',
        'breakSlots', 'dateSlotBlocks', 'updatedAt'
      ])
      && data.keys().hasOnly([
        'id', 'barberId', 'offWeekdays', 'offDates',
        'breakSlots', 'breakRanges', 'dateSlotBlocks', 'updatedAt'
      ])
      && isValidId(data.id)
      && isValidBarberSlug(data.barberId)
      && data.offWeekdays is list && data.offWeekdays.size() <= 7
      && data.offDates is list && data.offDates.size() <= 60
      && data.breakSlots is list && data.breakSlots.size() <= 20
      && (!('breakRanges' in data) || (data.breakRanges is list && data.breakRanges.size() <= 20))
      && data.dateSlotBlocks is list && data.dateSlotBlocks.size() <= 100
      && data.updatedAt is string && data.updatedAt.size() >= 10 && data.updatedAt.size() <= 64;
    }

    function isValidCrmClient(data) {
      return data.keys().hasAll([
        'id', 'normalizedPhone', 'phoneDisplay', 'clientName',
        'isVip', 'noShowCount', 'isBanned',
        'freeWashesRedeemed', 'customDiscountMAD', 'updatedAt'
      ])
      && data.keys().hasOnly([
        'id', 'normalizedPhone', 'phoneDisplay', 'clientName',
        'isVip', 'noShowCount', 'isBanned', 'banReason',
        'freeWashesRedeemed', 'customDiscountMAD', 'verifiedVisits',
        'loyaltyPoints', 'pointsEarnedTotal', 'pointsRedeemedTotal',
        'rewardNote', 'updatedAt'
      ])
      && isValidId(data.id)
      && data.normalizedPhone is string && data.normalizedPhone.size() >= 4 && data.normalizedPhone.size() <= 32
      && data.phoneDisplay is string && data.phoneDisplay.size() >= 4 && data.phoneDisplay.size() <= 40
      && data.clientName is string && data.clientName.size() >= 1 && data.clientName.size() <= 120
      && data.isVip is bool
      && data.noShowCount is number && data.noShowCount >= 0 && data.noShowCount <= 500
      && data.isBanned is bool
      && (!('banReason' in data) || (data.banReason is string && data.banReason.size() <= 300))
      && data.freeWashesRedeemed is number && data.freeWashesRedeemed >= 0 && data.freeWashesRedeemed <= 500
      && data.customDiscountMAD is number && data.customDiscountMAD >= 0 && data.customDiscountMAD <= 10000
      && (!('verifiedVisits' in data) || (data.verifiedVisits is number && data.verifiedVisits >= 0 && data.verifiedVisits <= 500))
      && (!('loyaltyPoints' in data) || (data.loyaltyPoints is number && data.loyaltyPoints >= 0 && data.loyaltyPoints <= 100000))
      && (!('pointsEarnedTotal' in data) || (data.pointsEarnedTotal is number && data.pointsEarnedTotal >= 0 && data.pointsEarnedTotal <= 100000))
      && (!('pointsRedeemedTotal' in data) || (data.pointsRedeemedTotal is number && data.pointsRedeemedTotal >= 0 && data.pointsRedeemedTotal <= 100000))
      && (!('rewardNote' in data) || (data.rewardNote is string && data.rewardNote.size() <= 300))
      && data.updatedAt is string && data.updatedAt.size() >= 10 && data.updatedAt.size() <= 64;
    }

    function isValidWaitlistEntry(data) {
      return data.keys().hasAll([
        'id', 'barberId', 'barberName', 'date',
        'preferredTime', 'clientName', 'clientPhone',
        'servicesSummary', 'status', 'createdAt'
      ])
      && data.keys().hasOnly([
        'id', 'barberId', 'barberName', 'date',
        'preferredTime', 'clientName', 'clientPhone',
        'servicesSummary', 'status', 'createdAt'
      ])
      && isValidId(data.id)
      && data.barberId is string && data.barberId.size() >= 1 && data.barberId.size() <= 64
      && data.barberName is string && data.barberName.size() >= 1 && data.barberName.size() <= 100
      && data.date is string && data.date.size() >= 8 && data.date.size() <= 20
      && data.preferredTime is string && data.preferredTime.size() >= 2 && data.preferredTime.size() <= 32
      && data.clientName is string && data.clientName.size() >= 1 && data.clientName.size() <= 120
      && data.clientPhone is string && data.clientPhone.size() >= 6 && data.clientPhone.size() <= 40
      && data.servicesSummary is string && data.servicesSummary.size() <= 300
      && data.status in ['waiting', 'notified', 'converted', 'cancelled']
      && data.createdAt is string && data.createdAt.size() >= 10 && data.createdAt.size() <= 64;
    }

    function isValidShiftRequest(data) {
      return data.keys().hasAll([
        'id', 'barberId', 'barberName', 'requestType',
        'targetDate', 'status', 'createdAt', 'updatedAt'
      ])
      && data.keys().hasOnly([
        'id', 'barberId', 'barberName', 'requestType',
        'targetDate', 'targetSlots', 'swapWithBarberId', 'swapWithBarberName',
        'swapDate', 'reason', 'status', 'reviewerNote',
        'reviewedBy', 'reviewedAt', 'createdAt', 'updatedAt'
      ])
      && isValidId(data.id)
      && data.barberId is string && data.barberId.size() >= 1 && data.barberId.size() <= 64
      && data.barberName is string && data.barberName.size() >= 1 && data.barberName.size() <= 100
      && data.requestType in ['day_off', 'day_open', 'slot_block', 'slot_open', 'shift_swap']
      && data.targetDate is string && data.targetDate.size() >= 8 && data.targetDate.size() <= 20
      && (!('targetSlots' in data) || (
        data.targetSlots is list
        && data.targetSlots.size() <= 12
        && (data.targetSlots.size() == 0 || data.targetSlots[0] is string)
      ))
      && (!('swapWithBarberId' in data) || (data.swapWithBarberId is string && data.swapWithBarberId.size() <= 64))
      && (!('swapWithBarberName' in data) || (data.swapWithBarberName is string && data.swapWithBarberName.size() <= 100))
      && (!('swapDate' in data) || (data.swapDate is string && data.swapDate.size() <= 20))
      && (!('reason' in data) || (data.reason is string && data.reason.size() <= 300))
      && data.status in ['pending', 'approved', 'rejected']
      && (!('reviewerNote' in data) || (data.reviewerNote is string && data.reviewerNote.size() <= 300))
      && (!('reviewedBy' in data) || (data.reviewedBy is string && data.reviewedBy.size() <= 100))
      && (!('reviewedAt' in data) || (data.reviewedAt is string && data.reviewedAt.size() <= 64))
      && data.createdAt is string && data.createdAt.size() >= 10 && data.createdAt.size() <= 64
      && data.updatedAt is string && data.updatedAt.size() >= 10 && data.updatedAt.size() <= 64;
    }

    function isValidReview(data) {
      return data.keys().hasAll([
        'id', 'barberId', 'barberName', 'author',
        'rating', 'comment', 'verified', 'createdAt'
      ])
      && data.keys().hasOnly([
        'id', 'barberId', 'barberName', 'author', 'city',
        'serviceName', 'rating', 'comment', 'dateLabel',
        'bookingId', 'verified', 'createdAt'
      ])
      && isValidId(data.id)
      && data.barberId is string && data.barberId.size() >= 1 && data.barberId.size() <= 64
      && data.barberName is string && data.barberName.size() >= 1 && data.barberName.size() <= 100
      && data.author is string && data.author.size() >= 1 && data.author.size() <= 120
      && (!('city' in data) || (data.city is string && data.city.size() <= 80))
      && (!('serviceName' in data) || (data.serviceName is string && data.serviceName.size() <= 120))
      && data.rating is number && data.rating >= 1 && data.rating <= 5
      && data.comment is string && data.comment.size() >= 1 && data.comment.size() <= 600
      && (!('dateLabel' in data) || (data.dateLabel is string && data.dateLabel.size() <= 64))
      && (!('bookingId' in data) || (data.bookingId is string && data.bookingId.size() <= 128))
      && data.verified is bool
      && data.createdAt is string && data.createdAt.size() >= 10 && data.createdAt.size() <= 64;
    }

    function isValidPushSubscription(data) {
      return data.keys().hasAll([
        'id', 'role', 'endpoint', 'p256dh', 'auth', 'createdAt', 'updatedAt'
      ])
      && data.keys().hasOnly([
        'id', 'role', 'normalizedPhone', 'clientPhone', 'clientName',
        'barberId', 'staffName', 'endpoint', 'p256dh', 'auth',
        'lang', 'userAgent', 'createdAt', 'updatedAt'
      ])
      && isValidId(data.id)
      && data.role in ['client', 'master', 'barber']
      && (!('normalizedPhone' in data) || (data.normalizedPhone is string && data.normalizedPhone.size() <= 32))
      && (!('clientPhone' in data) || (data.clientPhone is string && data.clientPhone.size() <= 40))
      && (!('clientName' in data) || (data.clientName is string && data.clientName.size() <= 120))
      && (!('barberId' in data) || (data.barberId is string && data.barberId.size() <= 64))
      && (!('staffName' in data) || (data.staffName is string && data.staffName.size() <= 100))
      && data.endpoint is string && data.endpoint.size() >= 10 && data.endpoint.size() <= 1000
      && data.endpoint.matches('^https://.*$')
      && data.p256dh is string && data.p256dh.size() >= 10 && data.p256dh.size() <= 300
      && data.auth is string && data.auth.size() >= 5 && data.auth.size() <= 200
      && (!('lang' in data) || data.lang in ['fr', 'ar', 'en', 'amz', 'es'])
      && (!('userAgent' in data) || (data.userAgent is string && data.userAgent.size() <= 300))
      && data.createdAt is string && data.createdAt.size() >= 10 && data.createdAt.size() <= 64
      && data.updatedAt is string && data.updatedAt.size() >= 10 && data.updatedAt.size() <= 64;
    }

    function isValidCaisseEntry(data) {
      return data.keys().hasAll([
        'id', 'barberId', 'barberName', 'type', 'date',
        'expectedAmountMAD', 'amountPaidMAD', 'creditAmountMAD', 'creditRemainingMAD',
        'createdByRole', 'createdByName', 'createdAt', 'updatedAt'
      ])
      && data.keys().hasOnly([
        'id', 'barberId', 'barberName', 'type', 'date',
        'serviceIds', 'serviceNames',
        'expectedAmountMAD', 'amountPaidMAD', 'creditAmountMAD', 'creditRemainingMAD',
        'creditStatus', 'clientName', 'clientPhone', 'expectedRepaymentDate',
        'repaidDate', 'repaidAmountMAD', 'parentCreditEntryId',
        'sourceBookingId', 'sourceTicketNumber', 'note',
        'createdByRole', 'createdByName', 'createdAt', 'updatedAt'
      ])
      && isValidId(data.id)
      && isValidBarberSlug(data.barberId)
      && data.barberName is string && data.barberName.size() >= 1 && data.barberName.size() <= 100
      && data.type in ['income', 'expense', 'float_adjustment', 'float_return', 'credit_repayment']
      && data.date is string && data.date.size() >= 8 && data.date.size() <= 20
      && (!('serviceIds' in data) || (data.serviceIds is list && data.serviceIds.size() <= 20))
      && (!('serviceNames' in data) || (data.serviceNames is list && data.serviceNames.size() <= 20))
      && data.expectedAmountMAD is number && data.expectedAmountMAD >= 0 && data.expectedAmountMAD <= 100000
      && data.amountPaidMAD is number && data.amountPaidMAD >= 0 && data.amountPaidMAD <= 100000
      && data.creditAmountMAD is number && data.creditAmountMAD >= 0 && data.creditAmountMAD <= 100000
      && data.creditRemainingMAD is number && data.creditRemainingMAD >= 0 && data.creditRemainingMAD <= 100000
      && (!('creditStatus' in data) || data.creditStatus in ['none', 'open', 'partial', 'paid'])
      && (!('clientName' in data) || (data.clientName is string && data.clientName.size() <= 120))
      && (!('clientPhone' in data) || (data.clientPhone is string && data.clientPhone.size() <= 40))
      && (!('expectedRepaymentDate' in data) || (data.expectedRepaymentDate is string && data.expectedRepaymentDate.size() <= 20))
      && (!('repaidDate' in data) || (data.repaidDate is string && data.repaidDate.size() <= 20))
      && (!('repaidAmountMAD' in data) || (data.repaidAmountMAD is number && data.repaidAmountMAD >= 0 && data.repaidAmountMAD <= 100000))
      && (!('parentCreditEntryId' in data) || (data.parentCreditEntryId is string && data.parentCreditEntryId.size() <= 128))
      && (!('sourceBookingId' in data) || (data.sourceBookingId is string && data.sourceBookingId.size() <= 128))
      && (!('sourceTicketNumber' in data) || (data.sourceTicketNumber is string && data.sourceTicketNumber.size() <= 32))
      && (!('note' in data) || (data.note is string && data.note.size() <= 400))
      && data.createdByRole in ['master', 'barber', 'caisse']
      && data.createdByName is string && data.createdByName.size() >= 1 && data.createdByName.size() <= 100
      && data.createdAt is string && data.createdAt.size() >= 10 && data.createdAt.size() <= 64
      && data.updatedAt is string && data.updatedAt.size() >= 10 && data.updatedAt.size() <= 64;
    }

    function isValidCaisseSetting(data) {
      return data.keys().hasAll([
        'id', 'barberId', 'commissionPercent', 'updatedBy', 'updatedAt'
      ])
      && data.keys().hasOnly([
        'id', 'barberId', 'commissionPercent', 'periodOverrides', 'updatedBy', 'updatedAt'
      ])
      && isValidId(data.id)
      && isValidBarberSlug(data.barberId)
      && data.commissionPercent is number && data.commissionPercent >= 0 && data.commissionPercent <= 100
      && (!('periodOverrides' in data) || (data.periodOverrides is list && data.periodOverrides.size() <= 24))
      && data.updatedBy is string && data.updatedBy.size() >= 1 && data.updatedBy.size() <= 100
      && data.updatedAt is string && data.updatedAt.size() >= 10 && data.updatedAt.size() <= 64;
    }

    function isValidCaisseSettlement(data) {
      return data.keys().hasAll([
        'id', 'barberId', 'barberName', 'date', 'collected',
        'collectedAmountMAD', 'barberShareMAD', 'shopShareMAD',
        'floatMAD', 'expensesMAD', 'carryOverOwedMAD', 'resetCount',
        'confirmedBy', 'confirmedAt', 'updatedAt'
      ])
      && data.keys().hasOnly([
        'id', 'barberId', 'barberName', 'date', 'collected',
        'collectedAmountMAD', 'barberShareMAD', 'shopShareMAD',
        'floatMAD', 'expensesMAD', 'carryOverOwedMAD', 'resetCount',
        'intakeClosed', 'grossIntakeClosedMAD', 'settlementMode',
        'note', 'confirmedBy', 'confirmedAt', 'updatedAt'
      ])
      && isValidId(data.id)
      && isValidBarberSlug(data.barberId)
      && data.barberName is string && data.barberName.size() >= 1 && data.barberName.size() <= 100
      && data.date is string && data.date.size() >= 8 && data.date.size() <= 20
      && data.collected is bool
      && data.collectedAmountMAD is number && data.collectedAmountMAD >= 0 && data.collectedAmountMAD <= 100000
      && data.barberShareMAD is number && data.barberShareMAD >= 0 && data.barberShareMAD <= 100000
      && data.shopShareMAD is number && data.shopShareMAD >= 0 && data.shopShareMAD <= 100000
      && data.floatMAD is number && data.floatMAD >= 0 && data.floatMAD <= 100000
      && data.expensesMAD is number && data.expensesMAD >= 0 && data.expensesMAD <= 100000
      && data.carryOverOwedMAD is number && data.carryOverOwedMAD >= 0 && data.carryOverOwedMAD <= 100000
      && data.resetCount is number && data.resetCount >= 0 && data.resetCount <= 1000
      && (!('intakeClosed' in data) || data.intakeClosed is bool)
      && (!('grossIntakeClosedMAD' in data) || (data.grossIntakeClosedMAD is number && data.grossIntakeClosedMAD >= 0 && data.grossIntakeClosedMAD <= 100000))
      && (!('settlementMode' in data) || data.settlementMode in ['daily_intake', 'daily_share'])
      && (!('note' in data) || (data.note is string && data.note.size() <= 400))
      && data.confirmedBy is string && data.confirmedBy.size() >= 1 && data.confirmedBy.size() <= 100
      && data.confirmedAt is string && data.confirmedAt.size() >= 10 && data.confirmedAt.size() <= 64
      && data.updatedAt is string && data.updatedAt.size() >= 10 && data.updatedAt.size() <= 64;
    }

    function isValidBarberProfile(data) {
      return data.keys().hasAll([
        'id', 'barberId', 'useCustomServices', 'customServices', 'updatedBy', 'updatedAt'
      ])
      && data.keys().hasOnly([
        'id', 'barberId', 'avatar', 'phone', 'whatsappNumber', 'instagramHandle',
        'bioAr', 'bioFr', 'bioEn',
        'useCustomServices', 'customServices', 'customServiceOverrides',
        'customHiddenServiceIds', 'customBundles', 'enableNoWaitOption',
        'updatedBy', 'updatedAt'
      ])
      && isValidId(data.id)
      && isValidBarberSlug(data.barberId)
      && data.id == data.barberId
      && (!('avatar' in data) || (data.avatar is string && data.avatar.size() <= 240000))
      && (!('phone' in data) || (data.phone is string && data.phone.size() <= 40))
      && (!('whatsappNumber' in data) || (data.whatsappNumber is string && data.whatsappNumber.size() <= 40))
      && (!('instagramHandle' in data) || (data.instagramHandle is string && data.instagramHandle.size() <= 100))
      && (!('bioAr' in data) || (data.bioAr is string && data.bioAr.size() <= 500))
      && (!('bioFr' in data) || (data.bioFr is string && data.bioFr.size() <= 500))
      && (!('bioEn' in data) || (data.bioEn is string && data.bioEn.size() <= 500))
      && data.useCustomServices is bool
      && data.customServices is list && data.customServices.size() <= 30
      && (!('customServiceOverrides' in data) || data.customServiceOverrides is map)
      && (!('customHiddenServiceIds' in data) || (data.customHiddenServiceIds is list && data.customHiddenServiceIds.size() <= 40))
      && (!('customBundles' in data) || (data.customBundles is list && data.customBundles.size() <= 40))
      && (!('enableNoWaitOption' in data) || data.enableNoWaitOption is bool)
      && data.updatedBy is string && data.updatedBy.size() >= 1 && data.updatedBy.size() <= 100
      && data.updatedAt is string && data.updatedAt.size() >= 10 && data.updatedAt.size() <= 64;
    }

    function isValidCaisseCycleSettlement(data) {
      return data.keys().hasAll([
        'id', 'barberId', 'barberName', 'settledThroughIso', 'settledThroughDate',
        'totalCollectedMAD', 'barberSharePaidMAD', 'shopShareMAD',
        'expensesMAD', 'floatMAD', 'creditsIssuedMAD', 'entryCount',
        'confirmedBy', 'confirmedAt'
      ])
      && data.keys().hasOnly([
        'id', 'barberId', 'barberName', 'settledThroughIso', 'settledThroughDate',
        'settlementPeriodScope', 'periodStartDate', 'periodEndDate',
        'totalCollectedMAD', 'barberSharePaidMAD', 'shopShareMAD',
        'expensesMAD', 'floatMAD', 'creditsIssuedMAD', 'entryCount',
        'note', 'confirmedBy', 'confirmedAt'
      ])
      && isValidId(data.id)
      && isValidBarberSlug(data.barberId)
      && data.barberName is string && data.barberName.size() >= 1 && data.barberName.size() <= 100
      && data.settledThroughIso is string && data.settledThroughIso.size() >= 10 && data.settledThroughIso.size() <= 64
      && data.settledThroughDate is string && data.settledThroughDate.size() >= 8 && data.settledThroughDate.size() <= 20
      && (!('settlementPeriodScope' in data) || data.settlementPeriodScope in ['full_open', 'month', 'custom_range'])
      && (!('periodStartDate' in data) || (data.periodStartDate is string && data.periodStartDate.size() <= 20))
      && (!('periodEndDate' in data) || (data.periodEndDate is string && data.periodEndDate.size() <= 20))
      && data.totalCollectedMAD is number && data.totalCollectedMAD >= 0 && data.totalCollectedMAD <= 10000000
      && data.barberSharePaidMAD is number && data.barberSharePaidMAD >= -10000000 && data.barberSharePaidMAD <= 10000000
      && data.shopShareMAD is number && data.shopShareMAD >= 0 && data.shopShareMAD <= 10000000
      && data.expensesMAD is number && data.expensesMAD >= 0 && data.expensesMAD <= 10000000
      && data.floatMAD is number && data.floatMAD >= 0 && data.floatMAD <= 10000000
      && data.creditsIssuedMAD is number && data.creditsIssuedMAD >= 0 && data.creditsIssuedMAD <= 10000000
      && data.entryCount is number && data.entryCount >= 0 && data.entryCount <= 100000
      && (!('note' in data) || (data.note is string && data.note.size() <= 400))
      && data.confirmedBy is string && data.confirmedBy.size() >= 1 && data.confirmedBy.size() <= 100
      && data.confirmedAt is string && data.confirmedAt.size() >= 10 && data.confirmedAt.size() <= 64;
    }

    function isValidCaisseDailyArchive(data) {
      return data.keys().hasAll([
        'id', 'barberId', 'barberName', 'date',
        'incomeMAD', 'repaymentIncomeMAD', 'expensesMAD', 'floatMAD', 'creditsIssuedMAD',
        'entryCount', 'entriesSummary', 'archivedAt'
      ])
      && data.keys().hasOnly([
        'id', 'barberId', 'barberName', 'date',
        'incomeMAD', 'repaymentIncomeMAD', 'expensesMAD', 'floatMAD', 'creditsIssuedMAD',
        'entryCount', 'entriesSummary', 'archivedAt'
      ])
      && isValidId(data.id)
      && isValidBarberSlug(data.barberId)
      && data.barberName is string && data.barberName.size() >= 1 && data.barberName.size() <= 100
      && data.date is string && data.date.size() >= 8 && data.date.size() <= 20
      && data.incomeMAD is number && data.incomeMAD >= 0 && data.incomeMAD <= 1000000
      && data.repaymentIncomeMAD is number && data.repaymentIncomeMAD >= 0 && data.repaymentIncomeMAD <= 1000000
      && data.expensesMAD is number && data.expensesMAD >= 0 && data.expensesMAD <= 1000000
      && data.floatMAD is number && data.floatMAD >= 0 && data.floatMAD <= 1000000
      && data.creditsIssuedMAD is number && data.creditsIssuedMAD >= 0 && data.creditsIssuedMAD <= 1000000
      && data.entryCount is number && data.entryCount >= 0 && data.entryCount <= 5000
      && data.entriesSummary is list && data.entriesSummary.size() <= 100
      && data.archivedAt is string && data.archivedAt.size() >= 10 && data.archivedAt.size() <= 64;
    }

    function isValidShopPricingConfig(data) {
      return data.keys().hasAll([
        'id', 'servicePriceOverrides', 'specialRules', 'updatedBy', 'updatedAt'
      ])
      && data.keys().hasOnly([
        'id', 'servicePriceOverrides', 'hiddenServiceIds', 'serviceBundles',
        'specialRules', 'enableNoWaitOption', 'giftWithHaircutBeardServiceId', 'updatedBy', 'updatedAt'
      ])
      && isValidId(data.id)
      && data.servicePriceOverrides is map
      && (!('hiddenServiceIds' in data) || (data.hiddenServiceIds is list && data.hiddenServiceIds.size() <= 40))
      && (!('serviceBundles' in data) || (data.serviceBundles is list && data.serviceBundles.size() <= 40))
      && data.specialRules is list && data.specialRules.size() <= 30
      && (!('enableNoWaitOption' in data) || data.enableNoWaitOption is bool)
      && (!('giftWithHaircutBeardServiceId' in data) || (data.giftWithHaircutBeardServiceId is string && data.giftWithHaircutBeardServiceId.size() <= 64))
      && data.updatedBy is string && data.updatedBy.size() >= 1 && data.updatedBy.size() <= 100
      && data.updatedAt is string && data.updatedAt.size() >= 10 && data.updatedAt.size() <= 64;
    }

    function isValidRosterMember(data) {
      return data.keys().hasAll([
        'id', 'nameAr', 'nameFr', 'role', 'status', 'pin',
        'colorKey', 'sortOrder', 'updatedBy', 'updatedAt'
      ])
      && data.keys().hasOnly([
        'id', 'nameAr', 'nameFr', 'nameEn', 'role', 'status', 'pin',
        'colorKey', 'sortOrder', 'isOwner', 'defaultAvatar',
        'defaultPhone', 'defaultWhatsapp', 'defaultInstagram',
        'replacesBarberId', 'replacedById', 'updatedBy', 'updatedAt'
      ])
      && isValidBarberSlug(data.id)
      && data.nameAr is string && data.nameAr.size() >= 1 && data.nameAr.size() <= 80
      && data.nameFr is string && data.nameFr.size() >= 1 && data.nameFr.size() <= 80
      && (!('nameEn' in data) || (data.nameEn is string && data.nameEn.size() <= 80))
      && data.role in ['master', 'barber', 'caisse']
      && data.status in ['active', 'archived']
      && data.pin is string && data.pin.size() >= 3 && data.pin.size() <= 32
      && data.colorKey in ['amber', 'blue', 'emerald', 'violet', 'teal', 'indigo', 'slate', 'stone', 'rose']
      && data.sortOrder is number && data.sortOrder >= 0 && data.sortOrder <= 1000
      && (!('isOwner' in data) || data.isOwner is bool)
      && (!('defaultAvatar' in data) || (data.defaultAvatar is string && data.defaultAvatar.size() <= 240000))
      && (!('defaultPhone' in data) || (data.defaultPhone is string && data.defaultPhone.size() <= 40))
      && (!('defaultWhatsapp' in data) || (data.defaultWhatsapp is string && data.defaultWhatsapp.size() <= 40))
      && (!('defaultInstagram' in data) || (data.defaultInstagram is string && data.defaultInstagram.size() <= 100))
      && (!('replacesBarberId' in data) || (data.replacesBarberId is string && data.replacesBarberId.size() <= 64))
      && (!('replacedById' in data) || (data.replacedById is string && data.replacedById.size() <= 64))
      && data.updatedBy is string && data.updatedBy.size() >= 1 && data.updatedBy.size() <= 100
      && data.updatedAt is string && data.updatedAt.size() >= 10 && data.updatedAt.size() <= 64;
    }

    function isValidClientCredit(data) {
      return data.keys().hasAll([
        'id', 'clientName', 'clientPhone', 'normalizedPhone',
        'amountOwedMAD', 'originalAmountMAD', 'status',
        'createdBy', 'createdAt', 'updatedAt'
      ])
      && data.keys().hasOnly([
        'id', 'clientName', 'clientPhone', 'normalizedPhone',
        'additionalPhones', 'normalizedAdditionalPhones',
        'amountOwedMAD', 'originalAmountMAD', 'status',
        'creditDate', 'note', 'createdBy', 'createdAt', 'updatedAt'
      ])
      && isValidId(data.id)
      && data.clientName is string && data.clientName.size() >= 1 && data.clientName.size() <= 120
      && data.clientPhone is string && data.clientPhone.size() <= 40
      && data.normalizedPhone is string && data.normalizedPhone.size() <= 32
      && (!('additionalPhones' in data) || (
        data.additionalPhones is list
        && data.additionalPhones.size() <= 5
        && (data.additionalPhones.size() == 0 || (data.additionalPhones[0] is string && data.additionalPhones[0].size() <= 40))
      ))
      && (!('normalizedAdditionalPhones' in data) || (
        data.normalizedAdditionalPhones is list
        && data.normalizedAdditionalPhones.size() <= 5
        && (data.normalizedAdditionalPhones.size() == 0 || (data.normalizedAdditionalPhones[0] is string && data.normalizedAdditionalPhones[0].size() <= 32))
      ))
      && data.amountOwedMAD is number && data.amountOwedMAD >= 0 && data.amountOwedMAD <= 100000
      && data.originalAmountMAD is number && data.originalAmountMAD >= 0 && data.originalAmountMAD <= 100000
      && data.status in ['open', 'partial', 'paid']
      && (!('creditDate' in data) || (data.creditDate is string && data.creditDate.size() <= 20))
      && (!('note' in data) || (data.note is string && data.note.size() <= 400))
      && data.createdBy is string && data.createdBy.size() >= 1 && data.createdBy.size() <= 100
      && data.createdAt is string && data.createdAt.size() >= 10 && data.createdAt.size() <= 64
      && data.updatedAt is string && data.updatedAt.size() >= 10 && data.updatedAt.size() <= 64;
    }

    function isValidCreditDispute(data) {
      return data.keys().hasAll([
        'id', 'clientName', 'clientPhone', 'normalizedPhone',
        'totalOwedSnapshotMAD', 'creditorSummary', 'message',
        'status', 'createdAt', 'updatedAt'
      ])
      && data.keys().hasOnly([
        'id', 'clientName', 'clientPhone', 'normalizedPhone',
        'totalOwedSnapshotMAD', 'creditorSummary', 'message',
        'targetBarberId', 'status', 'staffNote', 'resolvedBy',
        'resolvedAt', 'createdAt', 'updatedAt'
      ])
      && isValidId(data.id)
      && data.clientName is string && data.clientName.size() >= 1 && data.clientName.size() <= 120
      && data.clientPhone is string && data.clientPhone.size() >= 6 && data.clientPhone.size() <= 40
      && data.normalizedPhone is string && data.normalizedPhone.size() >= 4 && data.normalizedPhone.size() <= 32
      && data.totalOwedSnapshotMAD is number && data.totalOwedSnapshotMAD >= 0 && data.totalOwedSnapshotMAD <= 100000
      && data.creditorSummary is string && data.creditorSummary.size() >= 1 && data.creditorSummary.size() <= 240
      && data.message is string && data.message.size() >= 1 && data.message.size() <= 600
      && (!('targetBarberId' in data) || (data.targetBarberId is string && data.targetBarberId.size() <= 64))
      && data.status in ['open', 'reviewed', 'resolved']
      && (!('staffNote' in data) || (data.staffNote is string && data.staffNote.size() <= 400))
      && (!('resolvedBy' in data) || (data.resolvedBy is string && data.resolvedBy.size() <= 100))
      && (!('resolvedAt' in data) || (data.resolvedAt is string && data.resolvedAt.size() <= 64))
      && data.createdAt is string && data.createdAt.size() >= 10 && data.createdAt.size() <= 64
      && data.updatedAt is string && data.updatedAt.size() >= 10 && data.updatedAt.size() <= 64;
    }

    // Connection check document for app boot health validation
    match /test/connection {
      allow get: if request.time != null;
    }

    // Public Google Maps & Business Profile configuration
    match /settings/{settingId} {
      allow get: if isValidId(settingId) && request.time != null;
      allow create, update: if isValidId(settingId)
        && settingId == 'salon_profile'
        && isValidSalonSettings(incoming());
    }

    // Barber shift, break, and off-day configurations
    match /barber_schedules/{scheduleId} {
      allow get: if isValidId(scheduleId) && request.time != null;
      allow list: if request.time != null;
      allow create, update: if isValidId(scheduleId)
        && isValidBarberSchedule(incoming())
        && incoming().id == scheduleId;
      allow delete: if isValidId(scheduleId) && request.time != null;
    }

    // Client CRM, Loyalty & Blacklist records
    match /crm_clients/{clientId} {
      allow get: if isValidId(clientId) && request.time != null;
      allow list: if request.time != null;
      allow create, update: if isValidId(clientId)
        && isValidCrmClient(incoming())
        && incoming().id == clientId;
      allow delete: if isValidId(clientId) && request.time != null;
    }

    // Smart Waitlist entries
    match /waitlist/{entryId} {
      allow get: if isValidId(entryId) && request.time != null;
      allow list: if request.time != null;
      allow create: if isValidId(entryId)
        && isValidWaitlistEntry(incoming())
        && incoming().id == entryId
        && incoming().status == 'waiting';
      allow update: if isValidId(entryId)
        && isValidWaitlistEntry(incoming())
        && incoming().id == existing().id
        && incoming().createdAt == existing().createdAt
        && incoming().barberId == existing().barberId
        && incoming().clientPhone == existing().clientPhone
        && incoming().diff(existing()).affectedKeys().hasOnly(['status']);
      allow delete: if isValidId(entryId) && request.time != null;
    }

    // Barber time-off, break-block, and shift-swap planner requests
    match /shift_requests/{requestId} {
      allow get: if isValidId(requestId) && request.time != null;
      allow list: if request.time != null;
      allow create: if isValidId(requestId)
        && isValidShiftRequest(incoming())
        && incoming().id == requestId
        && incoming().status == 'pending';
      allow update: if isValidId(requestId)
        && isValidShiftRequest(incoming())
        && incoming().id == existing().id
        && incoming().barberId == existing().barberId
        && incoming().requestType == existing().requestType
        && incoming().targetDate == existing().targetDate
        && incoming().createdAt == existing().createdAt
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'status', 'reviewerNote', 'reviewedBy', 'reviewedAt', 'updatedAt'
        ]);
      allow delete: if isValidId(requestId) && request.time != null;
    }

    // Bookings collection: real-time synchronized appointments & tickets
    match /bookings/{bookingId} {
      allow get: if isValidId(bookingId) && request.time != null;
      allow list: if request.time != null;

      // Clients can submit new bookings with initial pending or flexible_pending status
      allow create: if isValidId(bookingId)
        && isValidBooking(incoming())
        && incoming().id == bookingId
        && incoming().status in ['pending', 'pending_quote', 'flexible_pending'];

      // Status, reschedule proposals, dates/times, notes, receipts, and loyalty reward tags
      allow update: if isValidId(bookingId)
        && isValidBooking(incoming())
        && incoming().id == existing().id
        && incoming().ticketNumber == existing().ticketNumber
        && incoming().createdAt == existing().createdAt
        && incoming().barberId == existing().barberId
        && incoming().clientName == existing().clientName
        && incoming().clientPhone == existing().clientPhone
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'status', 'adminNotes', 'rescheduledTo', 'date', 'timeSlot',
          'cihReceiptName', 'cihReceiptPreview', 'cihReceiptUploadedAt',
          'loyaltyRewardApplied', 'attendanceConfirmedAt',
          'checkedInAt', 'caisseLoggedAt', 'caisseEntryId'
        ]);

      allow delete: if isValidId(bookingId) && request.time != null;
    }

    // Verified barber reviews & star ratings
    match /reviews/{reviewId} {
      allow get: if isValidId(reviewId) && request.time != null;
      allow list: if request.time != null;
      allow create: if isValidId(reviewId)
        && isValidReview(incoming())
        && incoming().id == reviewId;
      allow update: if false;
      allow delete: if isValidId(reviewId) && request.time != null;
    }

    // VAPID Web Push subscriptions for clients and salon staff
    match /push_subscriptions/{subscriptionId} {
      allow get: if isValidId(subscriptionId) && request.time != null;
      allow list: if request.time != null;
      allow create, update: if isValidId(subscriptionId)
        && isValidPushSubscription(incoming())
        && incoming().id == subscriptionId;
      allow delete: if isValidId(subscriptionId) && request.time != null;
    }

    // Caisse & Accounting entries per barber and shop box
    match /caisse_entries/{entryId} {
      allow get: if isValidId(entryId) && request.time != null;
      allow list: if request.time != null;
      allow create: if isValidId(entryId)
        && isValidCaisseEntry(incoming())
        && incoming().id == entryId;
      allow update: if isValidId(entryId)
        && isValidCaisseEntry(incoming())
        && incoming().id == existing().id
        && incoming().createdAt == existing().createdAt
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'barberId', 'barberName', 'type', 'date',
          'serviceIds', 'serviceNames',
          'expectedAmountMAD', 'amountPaidMAD', 'creditAmountMAD', 'creditRemainingMAD',
          'creditStatus', 'clientName', 'clientPhone', 'expectedRepaymentDate',
          'repaidDate', 'repaidAmountMAD', 'note', 'updatedAt'
        ]);
      allow delete: if isValidId(entryId) && request.time != null;
    }

    // Caisse commission percentage settings per barber
    match /caisse_settings/{settingId} {
      allow get: if isValidId(settingId) && request.time != null;
      allow list: if request.time != null;
      allow create, update: if isValidId(settingId)
        && isValidCaisseSetting(incoming())
        && incoming().id == settingId
        && incoming().barberId == settingId;
      allow delete: if isValidId(settingId) && request.time != null;
    }

    // Caisse daily collection status, recalculate/reset state, and carry-over tracking
    match /caisse_settlements/{settlementId} {
      allow get: if isValidId(settlementId) && request.time != null;
      allow list: if request.time != null;
      allow create, update: if isValidId(settlementId)
        && isValidCaisseSettlement(incoming())
        && incoming().id == settlementId;
      allow delete: if isValidId(settlementId) && request.time != null;
    }

    // Live editable barber profiles & personal service menus
    match /barber_profiles/{barberId} {
      allow get: if isValidId(barberId) && request.time != null;
      allow list: if request.time != null;
      allow create, update: if isValidId(barberId)
        && isValidBarberProfile(incoming())
        && incoming().id == barberId;
      allow delete: if isValidId(barberId) && request.time != null;
    }

    // Master-confirmed cumulative Caisse payout cycle snapshots
    match /caisse_cycles/{cycleId} {
      allow get: if isValidId(cycleId) && request.time != null;
      allow list: if request.time != null;
      allow create, update: if isValidId(cycleId)
        && isValidCaisseCycleSettlement(incoming())
        && incoming().id == cycleId;
      allow delete: if isValidId(cycleId) && request.time != null;
    }

    // 03:00 AM business-day Caisse daily archives per barber
    match /caisse_daily_archives/{archiveId} {
      allow get: if isValidId(archiveId) && request.time != null;
      allow list: if request.time != null;
      allow create, update: if isValidId(archiveId)
        && isValidCaisseDailyArchive(incoming())
        && incoming().id == archiveId;
      allow delete: if isValidId(archiveId) && request.time != null;
    }

    // Master-Admin-only official salon service pricing, bundles, visibility, & special day/Eid rules
    match /shop_pricing/{configId} {
      allow get: if isValidId(configId) && request.time != null;
      allow list: if request.time != null;
      allow create, update: if isValidId(configId)
        && configId == 'default'
        && isValidShopPricingConfig(incoming())
        && incoming().id == configId;
      allow delete: if false;
    }

    // Dynamic barber & staff roster (passwords, active/archived barbers, shared Caisse account)
    match /barber_roster/{memberId} {
      allow get: if isValidId(memberId) && request.time != null;
      allow list: if request.time != null;
      allow create, update: if isValidId(memberId)
        && isValidRosterMember(incoming())
        && incoming().id == memberId;
      allow delete: if isValidId(memberId)
        && isValidBarberSlug(memberId)
        && memberId != 'hassan'
        && memberId != 'caisse_register'
        && request.time != null;
    }

    // Master Admin debtor registry ("الناس لي كانتسالهم")
    match /client_credits/{creditId} {
      allow get: if isValidId(creditId) && request.time != null;
      allow list: if request.time != null;
      allow create: if isValidId(creditId)
        && isValidClientCredit(incoming())
        && incoming().id == creditId;
      allow update: if isValidId(creditId)
        && isValidClientCredit(incoming())
        && incoming().id == existing().id
        && incoming().createdAt == existing().createdAt
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'clientName', 'clientPhone', 'normalizedPhone',
          'additionalPhones', 'normalizedAdditionalPhones',
          'amountOwedMAD', 'originalAmountMAD', 'status',
          'creditDate', 'note', 'updatedAt'
        ]);
      allow delete: if isValidId(creditId) && request.time != null;
    }

    // Client credit objections & inquiries submitted via booking credit alert
    match /credit_disputes/{disputeId} {
      allow get: if isValidId(disputeId) && request.time != null;
      allow list: if request.time != null;
      allow create: if isValidId(disputeId)
        && isValidCreditDispute(incoming())
        && incoming().id == disputeId
        && incoming().status == 'open';
      allow update: if isValidId(disputeId)
        && isValidCreditDispute(incoming())
        && incoming().id == existing().id
        && incoming().createdAt == existing().createdAt
        && incoming().normalizedPhone == existing().normalizedPhone
        && incoming().message == existing().message
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'status', 'staffNote', 'resolvedBy', 'resolvedAt', 'updatedAt'
        ]);
      allow delete: if isValidId(disputeId) && request.time != null;
    }

    function isValidBarberDailyNote(data) {
      return data.keys().hasAll([
        'id', 'barberId', 'barberName', 'date',
        'masterNote', 'masterUpdatedBy', 'masterUpdatedAt',
        'createdAt', 'updatedAt'
      ])
      && data.keys().hasOnly([
        'id', 'barberId', 'barberName', 'date',
        'masterNote', 'masterUpdatedBy', 'masterUpdatedAt',
        'barberReply', 'barberRepliedBy', 'barberRepliedAt',
        'createdAt', 'updatedAt'
      ])
      && isValidId(data.id)
      && isValidBarberSlug(data.barberId)
      && data.barberName is string && data.barberName.size() >= 1 && data.barberName.size() <= 100
      && data.date is string && data.date.size() >= 8 && data.date.size() <= 20
      && data.id == data.barberId + '_' + data.date
      && data.masterNote is string && data.masterNote.size() <= 600
      && data.masterUpdatedBy is string && data.masterUpdatedBy.size() >= 1 && data.masterUpdatedBy.size() <= 100
      && data.masterUpdatedAt is string && data.masterUpdatedAt.size() >= 10 && data.masterUpdatedAt.size() <= 64
      && (!('barberReply' in data) || (data.barberReply is string && data.barberReply.size() <= 600))
      && (!('barberRepliedBy' in data) || (data.barberRepliedBy is string && data.barberRepliedBy.size() <= 100))
      && (!('barberRepliedAt' in data) || (data.barberRepliedAt is string && data.barberRepliedAt.size() <= 64))
      && data.createdAt is string && data.createdAt.size() >= 10 && data.createdAt.size() <= 64
      && data.updatedAt is string && data.updatedAt.size() >= 10 && data.updatedAt.size() <= 64;
    }

    // Daily notes written by Master Admin per barber + barber responses
    match /barber_daily_notes/{noteId} {
      allow get: if isValidId(noteId) && request.time != null;
      allow list: if request.time != null;
      allow create: if isValidId(noteId)
        && isValidBarberDailyNote(incoming())
        && incoming().id == noteId;
      allow update: if isValidId(noteId)
        && isValidBarberDailyNote(incoming())
        && incoming().id == existing().id
        && incoming().barberId == existing().barberId
        && incoming().date == existing().date
        && incoming().createdAt == existing().createdAt
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'masterNote', 'masterUpdatedBy', 'masterUpdatedAt',
          'barberReply', 'barberRepliedBy', 'barberRepliedAt',
          'updatedAt'
        ]);
      allow delete: if isValidId(noteId) && request.time != null;
    }
  }
}
