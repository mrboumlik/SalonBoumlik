  "firestore": {
    "/bookings/{bookingId}": {
      "schema": {
        "$ref": "#/entities/Booking"
      },
      "description": "Real-time cloud collection storing all Salon Boumlik client appointments and digital tickets"
    },
    "/barber_schedules/{scheduleId}": {
      "schema": {
        "$ref": "#/entities/BarberSchedule"
      },
      "description": "Barber shift, off-days, and break configuration"
    },
    "/crm_clients/{clientId}": {
      "schema": {
        "$ref": "#/entities/CrmClient"
      },
      "description": "CRM loyalty, VIP flags, no-show strikes, and blacklist profiles"
    },
    "/waitlist/{entryId}": {
      "schema": {
        "$ref": "#/entities/WaitlistEntry"
      },
