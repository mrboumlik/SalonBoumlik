      "required": [
        "id",
        "barberId",
        "barberName",
        "date",
        "collected",
        "collectedAmountMAD",
        "barberShareMAD",
        "shopShareMAD",
        "floatMAD",
        "expensesMAD",
        "carryOverOwedMAD",
        "resetCount",
        "confirmedBy",
