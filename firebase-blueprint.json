{
  "entities": {
    "Booking": {
      "title": "Booking",
      "description": "A barbershop appointment booking and digital ticket at Salon Boumlik",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique booking document identifier",
          "minLength": 3,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "ticketNumber": {
          "type": "string",
          "description": "Human-readable ticket code (e.g., #SB-1024)",
          "minLength": 3,
          "maxLength": 32
        },
        "barberId": {
          "type": "string",
          "description": "Identifier of the assigned barber",
          "minLength": 1,
          "maxLength": 64
        },
        "barberName": {
          "type": "string",
          "description": "Display name of the assigned barber",
          "minLength": 1,
          "maxLength": 100
        },
        "barberColor": {
          "type": "string",
          "description": "Hex color associated with the barber",
          "maxLength": 20
        },
        "date": {
          "type": "string",
          "description": "Appointment date in YYYY-MM-DD format",
          "minLength": 8,
          "maxLength": 20
        },
        "timeSlot": {
          "type": "string",
          "description": "Scheduled time slot in HH:MM format",
          "minLength": 3,
          "maxLength": 16
        },
        "clientName": {
          "type": "string",
          "description": "Client full name",
          "minLength": 1,
          "maxLength": 120
        },
        "clientPhone": {
          "type": "string",
          "description": "Client phone / WhatsApp number",
          "minLength": 6,
          "maxLength": 40
        },
        "clientEmail": {
          "type": "string",
          "description": "Optional client email address",
          "maxLength": 120
        },
        "clientNotes": {
          "type": "string",
          "description": "Optional special requests or grooming preferences entered by client",
          "maxLength": 400
        },
        "notes": {
          "type": "string",
          "description": "Optional client notes or haircut preferences",
          "maxLength": 500
        },
        "services": {
          "type": "array",
          "description": "Legacy service objects array"
        },
        "cartItemsSummary": {
          "type": "array",
          "description": "Selected service cart items with bundle pricing details"
        },
        "originalTotalMAD": {
          "type": "number",
          "description": "Subtotal before discounts in MAD"
        },
        "finalTotalMAD": {
          "type": "number",
          "description": "Final total payable in MAD"
        },
        "totalSavingsMAD": {
          "type": "number",
          "description": "Discount savings in MAD"
        },
        "bookingMethod": {
          "type": "string",
          "enum": ["site", "whatsapp"],
          "description": "Channel used for booking"
        },
        "drinkPreference": {
          "type": "string",
          "enum": ["coffee", "tea", "none"],
          "description": "Optional drink preference"
        },
        "totalDurationMinutes": {
          "type": "number",
          "description": "Estimated service duration in minutes"
        },
        "status": {
          "type": "string",
          "enum": ["pending", "pending_quote", "flexible_pending", "confirmed", "rescheduled", "completed", "no_show", "rejected", "cancelled"],
          "description": "Current appointment workflow status"
        },
        "isFlexibleTime": {
          "type": "boolean",
          "description": "True when client lets the barber assign the closest suitable time slot"
        },
        "preferredTimeHint": {
          "type": "string",
          "description": "Optional preferred hour requested before switching to barber-assigned flexible time",
          "maxLength": 32
        },
        "rescheduledTo": {
          "type": "object",
          "description": "Proposed new date and time when status is rescheduled"
        },
        "clientLanguage": {
          "type": "string",
          "enum": ["fr", "ar", "en", "amz", "es"],
          "description": "Client preferred UI language"
        },
        "adminNotes": {
          "type": "string",
          "description": "Staff/barber response note visible to client",
          "maxLength": 500
        },
        "cihReceiptName": {
          "type": "string",
          "description": "Optional filename of uploaded CIH Bank transfer receipt",
          "maxLength": 160
        },
        "cihReceiptPreview": {
          "type": "string",
          "description": "Compressed base64 image preview of CIH transfer receipt (<=200KB)",
          "maxLength": 200000
        },
        "cihReceiptUploadedAt": {
          "type": "string",
          "format": "date-time",
          "description": "ISO timestamp when CIH receipt was attached",
          "maxLength": 64
        },
        "loyaltyRewardApplied": {
          "type": "string",
          "description": "Optional loyalty reward label applied by admin",
          "maxLength": 200
        },
        "attendanceConfirmedAt": {
          "type": "string",
          "format": "date-time",
          "description": "ISO timestamp when admin confirmed client attendance for verified loyalty progress",
          "maxLength": 64
        },
        "checkInToken": {
          "type": "string",
          "description": "Unique booking check-in QR verification code",
          "maxLength": 32
        },
        "checkedInAt": {
          "type": "string",
          "format": "date-time",
          "description": "ISO timestamp when client checked in via QR scan at salon",
          "maxLength": 64
        },
        "caisseLoggedAt": {
          "type": "string",
          "format": "date-time",
          "description": "ISO timestamp when completed appointment payment was logged to Caisse",
          "maxLength": 64
        },
        "caisseEntryId": {
          "type": "string",
          "description": "Linked CaisseEntry document ID created after attendance confirmation",
          "maxLength": 128
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "ISO timestamp when booking was created",
          "maxLength": 64
        }
      },
      "required": [
        "id",
        "ticketNumber",
        "barberId",
        "barberName",
        "date",
        "timeSlot",
        "clientName",
        "clientPhone",
        "status",
        "createdAt"
      ]
    },
    "BarberSchedule": {
      "title": "BarberSchedule",
      "description": "Barber shift, off-days, and break configuration",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 3,
          "maxLength": 64,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "barberId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "offWeekdays": {
          "type": "array",
          "description": "Weekday indices (0=Sun..6=Sat) when barber is off"
        },
        "offDates": {
          "type": "array",
          "description": "Specific YYYY-MM-DD dates when barber is unavailable"
        },
        "breakSlots": {
          "type": "array",
          "description": "Recurring HH:MM slots blocked for breaks"
        },
        "dateSlotBlocks": {
          "type": "array",
          "description": "Specific YYYY-MM-DD@HH:MM blocked slots"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "maxLength": 64
        }
      },
      "required": [
        "id",
        "barberId",
        "offWeekdays",
        "offDates",
        "breakSlots",
        "dateSlotBlocks",
        "updatedAt"
      ]
    },
    "CrmClient": {
      "title": "CrmClient",
      "description": "CRM loyalty, VIP status, no-show counter, and blacklist controls per client phone",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 5,
          "maxLength": 64,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "normalizedPhone": {
          "type": "string",
          "minLength": 4,
          "maxLength": 32
        },
        "phoneDisplay": {
          "type": "string",
          "minLength": 4,
          "maxLength": 40
        },
        "clientName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "isVip": {
          "type": "boolean"
        },
        "noShowCount": {
          "type": "number"
        },
        "isBanned": {
          "type": "boolean"
        },
        "banReason": {
          "type": "string",
          "maxLength": 300
        },
        "freeWashesRedeemed": {
          "type": "number"
        },
        "customDiscountMAD": {
          "type": "number"
        },
        "verifiedVisits": {
          "type": "number",
          "description": "Verified attendance count incremented only when admin confirms booking completion"
        },
        "loyaltyPoints": {
          "type": "number",
          "description": "Current redeemable loyalty points balance earned from visits"
        },
        "pointsEarnedTotal": {
          "type": "number",
          "description": "Lifetime cumulative loyalty points earned"
        },
        "pointsRedeemedTotal": {
          "type": "number",
          "description": "Lifetime cumulative loyalty points redeemed for service discounts"
        },
        "rewardNote": {
          "type": "string",
          "maxLength": 300
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "maxLength": 64
        }
      },
      "required": [
        "id",
        "normalizedPhone",
        "phoneDisplay",
        "clientName",
        "isVip",
        "noShowCount",
        "isBanned",
        "freeWashesRedeemed",
        "customDiscountMAD",
        "updatedAt"
      ]
    },
    "WaitlistEntry": {
      "title": "WaitlistEntry",
      "description": "Smart waitlist registration when desired slots are fully booked",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 3,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "barberId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "barberName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "date": {
          "type": "string",
          "minLength": 8,
          "maxLength": 20
        },
        "preferredTime": {
          "type": "string",
          "minLength": 2,
          "maxLength": 32
        },
        "clientName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "clientPhone": {
          "type": "string",
          "minLength": 6,
          "maxLength": 40
        },
        "servicesSummary": {
          "type": "string",
          "maxLength": 300
        },
        "status": {
          "type": "string",
          "enum": ["waiting", "notified", "converted", "cancelled"]
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "maxLength": 64
        }
      },
      "required": [
        "id",
        "barberId",
        "barberName",
        "date",
        "preferredTime",
        "clientName",
        "clientPhone",
        "servicesSummary",
        "status",
        "createdAt"
      ]
    },
    "SalonSettings": {
      "title": "SalonSettings",
      "description": "Public Google Maps and Google Business Profile configuration for Salon Boumlik",
      "type": "object",
      "properties": {
        "googleMapsUrl": {
          "type": "string",
          "description": "Direct Google Maps navigation URL",
          "minLength": 10,
          "maxLength": 500
        },
        "googleReviewUrl": {
          "type": "string",
          "description": "Direct Google Business Profile review URL",
          "minLength": 10,
          "maxLength": 500
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "ISO timestamp of last settings update",
          "maxLength": 64
        }
      },
      "required": [
        "googleMapsUrl",
        "googleReviewUrl",
        "updatedAt"
      ]
    },
    "ShiftRequest": {
      "title": "ShiftRequest",
      "description": "Barber time-off, slot break, or shift-swap request reviewed by the Master Admin",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 3,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "barberId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "barberName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "requestType": {
          "type": "string",
          "enum": ["day_off", "day_open", "slot_block", "slot_open", "shift_swap"]
        },
        "targetDate": {
          "type": "string",
          "minLength": 8,
          "maxLength": 20
        },
        "targetSlots": {
          "type": "array",
          "description": "Specific HH:MM slots requested for block or swap (up to 12)"
        },
        "swapWithBarberId": {
          "type": "string",
          "maxLength": 64
        },
        "swapWithBarberName": {
          "type": "string",
          "maxLength": 100
        },
        "swapDate": {
          "type": "string",
          "maxLength": 20
        },
        "reason": {
          "type": "string",
          "maxLength": 300
        },
        "status": {
          "type": "string",
          "enum": ["pending", "approved", "rejected"]
        },
        "reviewerNote": {
          "type": "string",
          "maxLength": 300
        },
        "reviewedBy": {
          "type": "string",
          "maxLength": 100
        },
        "reviewedAt": {
          "type": "string",
          "format": "date-time",
          "maxLength": 64
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "maxLength": 64
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "maxLength": 64
        }
      },
      "required": [
        "id",
        "barberId",
        "barberName",
        "requestType",
        "targetDate",
        "status",
        "createdAt",
        "updatedAt"
      ]
    },
