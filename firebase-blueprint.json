        },
        "dateLabel": {
          "type": "string",
          "maxLength": 64
        },
        "verified": {
          "type": "boolean"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "maxLength": 64
        }
      },
      "required": [
        "id",
        "barberId",
        "barberName",
        "author",
        "rating",
        "comment",
        "verified",
        "createdAt"
      ]
    },
    "PushSubscriptionRecord": {
      "title": "PushSubscriptionRecord",
      "description": "Web Push VAPID subscription record linked to a client phone number or barber/admin staff profile",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 3,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "role": {
          "type": "string",
          "enum": ["client", "master", "barber"]
        },
        "normalizedPhone": {
          "type": "string",
          "maxLength": 32
        },
        "clientPhone": {
          "type": "string",
          "maxLength": 40
        },
        "clientName": {
          "type": "string",
          "maxLength": 120
        },
        "barberId": {
          "type": "string",
          "maxLength": 64
        },
        "staffName": {
          "type": "string",
          "maxLength": 100
        },
        "endpoint": {
          "type": "string",
          "minLength": 10,
          "maxLength": 1000
        },
        "p256dh": {
          "type": "string",
          "minLength": 10,
          "maxLength": 300
        },
        "auth": {
          "type": "string",
          "minLength": 5,
          "maxLength": 200
        },
        "lang": {
          "type": "string",
          "enum": ["fr", "ar", "en", "amz", "es"]
        },
        "userAgent": {
          "type": "string",
          "maxLength": 300
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "maxLength": 64
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "maxLength": 64
        }
      },
      "required": [
        "id",
        "role",
        "endpoint",
        "p256dh",
        "auth",
        "createdAt",
        "updatedAt"
      ]
    },
    "CaisseEntry": {
      "title": "CaisseEntry",
      "description": "Barber or shop cash register transaction (income, expense, float adjustment, credit repayment)",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 3,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "barberId": {
          "type": "string",
          "enum": ["hassan", "anouar-arif", "lahcen-lhanz", "mounir-querdeny"]
        },
        "barberName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "type": {
          "type": "string",
          "enum": ["income", "expense", "float_adjustment", "credit_repayment"]
        },
        "date": {
          "type": "string",
          "minLength": 8,
          "maxLength": 20
        },
        "serviceIds": {
          "type": "array"
        },
        "serviceNames": {
          "type": "array"
        },
        "expectedAmountMAD": {
          "type": "number"
        },
        "amountPaidMAD": {
          "type": "number"
        },
        "creditAmountMAD": {
          "type": "number"
        },
        "creditRemainingMAD": {
          "type": "number"
        },
        "creditStatus": {
          "type": "string",
          "enum": ["none", "open", "partial", "paid"]
        },
        "clientName": {
          "type": "string",
          "maxLength": 120
        },
        "clientPhone": {
          "type": "string",
          "maxLength": 40
        },
        "expectedRepaymentDate": {
          "type": "string",
          "maxLength": 20
        },
        "repaidDate": {
          "type": "string",
          "maxLength": 20
        },
        "repaidAmountMAD": {
          "type": "number"
        },
        "parentCreditEntryId": {
          "type": "string",
          "maxLength": 128
        },
        "sourceBookingId": {
          "type": "string",
          "maxLength": 128
        },
        "sourceTicketNumber": {
          "type": "string",
          "maxLength": 32
        },
        "note": {
          "type": "string",
          "maxLength": 400
        },
        "createdByRole": {
          "type": "string",
          "enum": ["master", "barber"]
        },
        "createdByName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "maxLength": 64
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "maxLength": 64
        }
      },
      "required": [
        "id",
        "barberId",
        "barberName",
        "type",
        "date",
        "expectedAmountMAD",
        "amountPaidMAD",
        "creditAmountMAD",
        "creditRemainingMAD",
        "createdByRole",
        "createdByName",
        "createdAt",
        "updatedAt"
      ]
    },
