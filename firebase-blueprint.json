        },
        "pointsEarnedTotal": {
          "type": "number",
          "description": "Lifetime cumulative loyalty points earned"
        },
        "pointsRedeemedTotal": {
          "type": "number",
          "description": "Lifetime cumulative loyalty points redeemed for service discounts"
        },
        "rewardNote": {
          "type": "string",
          "maxLength": 300
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "maxLength": 64
        }
      },
      "required": [
        "id",
        "normalizedPhone",
        "phoneDisplay",
        "clientName",
        "isVip",
        "noShowCount",
        "isBanned",
        "freeWashesRedeemed",
        "customDiscountMAD",
        "updatedAt"
      ]
    },
